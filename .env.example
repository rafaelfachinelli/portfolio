# Contact form (https://resend.com). Copy this file to .env.local and fill in.
RESEND_API_KEY=
# Address that receives contact form messages.
CONTACT_TO_EMAIL=rafael.l.a.fachinelli@gmail.com
# Sender. "onboarding@resend.dev" works for testing; use a verified domain in production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: raises the GitHub API rate limit used by the "More projects" page.
GITHUB_TOKEN=

# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://rafaelfachinelli.com
